APP_NAME=RiceVibe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ricevibe.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ricevibe
